# ============================================
# InfoRocha Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# --- General ---
DEBUG=False

# --- Security ---
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS ---
# Comma-separated list of allowed origins, or "*" for all
# Example: CORS_ORIGINS=https://tu-app.vercel.app,http://localhost:3000
CORS_ORIGINS=*

# --- Database ---
# Option 1: Direct URL (preferred for deployment platforms like Render)
# DATABASE_URL_OVERRIDE=mysql+pymysql://user:password@host:port/dbname

# Option 2: Individual MySQL params (for local development)
MYSQL_USER=root
MYSQL_PASSWORD=your-password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=inforocha
